# Copy this file to .env and fill in your key. Never commit .env.
#
# ReviewLens talks to any OpenAI-compatible chat completions API.
# Default: Groq (free tier) - get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier) instead - key from https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Optional tuning
PORT=3001
BATCH_SIZE=5
LLM_MAX_ATTEMPTS=4
LLM_BASE_DELAY_MS=1000
